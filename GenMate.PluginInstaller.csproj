<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.1.1</Version>
    <AssemblyTitle>GenMate Plugin Installer</AssemblyTitle>
    <Product>GenMate Plugin Installer</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/genmate-installer-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The self-contained publish is what the launch-time self-update downloads, so its size is a
       cost the user pays. Compression more than halves it - roughly 145 MB to 65 MB, measured
       2026-08-24 - in exchange for a slower first start, which extracts to a cache. Set
       here rather than on the publish command lines so both workflows cannot drift apart.
       Trimming, the obvious other lever, is refused outright by the SDK for WPF (NETSDK1168). -->
  <PropertyGroup>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core/GenMate.PluginInstaller.Core.csproj" />
  </ItemGroup>

  <!-- Core/ and Tests/ are separate projects nested under this one, because this project sits at
       the repository root. Without these removals the SDK's default globs would compile their
       sources into this assembly as well as their own. -->
  <ItemGroup>
    <Compile Remove="Core/**;Tests/**" />
    <None Remove="Core/**;Tests/**" />
    <EmbeddedResource Remove="Core/**;Tests/**" />
    <Page Remove="Core/**;Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources/Fonts/*.ttf" />
    <Resource Include="Resources/genmate-installer-icon.ico" />
  </ItemGroup>

</Project>
