<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0, not net10.0-windows: the self-update and channel code must be unit-testable on the
       WSL build machine, and a project that pulls in Microsoft.WindowsDesktop.App cannot run there.
       Anything needing WPF, the registry, or ProgramData stays in the app project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
